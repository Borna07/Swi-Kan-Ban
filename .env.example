# Azure AD SPA app registration
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=

# SharePoint site + list (Microsoft Graph IDs)
NEXT_PUBLIC_SHAREPOINT_SITE_ID=
NEXT_PUBLIC_SHAREPOINT_LIST_ID=

# Document library folder path (files stay in SharePoint; cards store URLs)
NEXT_PUBLIC_SHAREPOINT_DOCS_PATH=/Shared Documents/SwiKanban

# Must match an SPA redirect URI on the app registration
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000
